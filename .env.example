# Kinship's settings. Copy this file to .env and fill in each value.
# Names only here; .env is never committed.

# Password for Kinship's own database. Use letters and digits only, because it
# goes into a connection string as-is. To make one: openssl rand -hex 24
# Set it before the first start: the database keeps the password it was made with.
POSTGRES_PASSWORD=

# The single owner's name. Every record is stored under it, so pick a fixed
# value (for example "me") and keep it. Kinship refuses to start without it.
KINSHIP_OWNER=

# Optional. The port Kinship answers on, on this computer only (127.0.0.1).
# Leave it empty for 3000.
KINSHIP_PORT=
