{
  "name": "kinship",
  "version": "0.4.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3000",
    "build": "prisma generate && next build",
    "start": "node server.js",
    "graph:benchmark": "node --expose-gc --import tsx scripts/benchmark-graph-layout.ts",
    "api:spec": "tsx scripts/api-spec.ts --write && prettier --write docs/api/kinship.openapi.json",
    "graph:types": "openapi-typescript docs/api/graph.openapi.json -o lib/graph/api.generated.ts && prettier --write lib/graph/api.generated.ts",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "prisma generate >/dev/null && vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "db:migrate": "node prisma/deploy-migrations.mjs",
    "db:migrate:create": "prisma migrate dev --create-only",
    "db:migrate:check": "node prisma/check-migrations.mjs",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "photos:check": "tsx prisma/check-photos.ts",
    "tasks:check": "tsx prisma/check-task-hierarchy.ts",
    "import:linkedin": "tsx prisma/import-linkedin.ts",
    "export": "tsx prisma/archive.ts export",
    "import": "tsx prisma/archive.ts import"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@floating-ui/dom": "^1.8.0",
    "@fullcalendar/core": "6.1.21",
    "@fullcalendar/daygrid": "6.1.21",
    "@fullcalendar/interaction": "6.1.21",
    "@fullcalendar/list": "6.1.21",
    "@fullcalendar/luxon3": "6.1.21",
    "@fullcalendar/react": "6.1.21",
    "@fullcalendar/timegrid": "6.1.21",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@radix-ui/react-avatar": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@tanstack/react-query": "^5.101.4",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-placeholder": "3.31.4",
    "@tiptap/extension-task-item": "3.31.4",
    "@tiptap/extension-task-list": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@tiptap/suggestion": "3.31.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "d3-force-3d": "3.0.6",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.33.0",
    "luxon": "^3.7.2",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.0.0",
    "three": "0.186.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/luxon": "^3.7.5",
    "@types/node": "24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "0.186.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "9.39.5",
    "eslint-import-resolver-node": "0.3.10",
    "eslint-import-resolver-typescript": "3.10.1",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "jsdom": "^29.1.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.9",
    "prisma": "^7.9.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "8.71.1",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "mysql2": "3.24.5",
    "deepmerge-ts": "8.0.2"
  }
}
